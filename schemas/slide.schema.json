{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://visual-report.dev/schemas/slide.schema.json",
  "title": "Visual Report Slide Plan",
  "description": "visual-report 的幻灯片检查点（slide-plan.json）。块定义复用 report.schema.json；一页一个核心主题；ID 全 deck 唯一。",
  "type": "object",
  "required": ["meta", "slides"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "meta": {
      "type": "object",
      "required": ["title", "theme"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "subtitle": { "type": "string" },
        "author": { "type": "string" },
        "date": { "type": "string" },
        "theme": { "enum": ["minimal", "corporate", "tech", "editorial", "dashboard"] },
        "lang": { "enum": ["zh-CN", "en"] },
        "schemaVersion": { "const": "0.1" },
        "footer": { "type": "string" }
      }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "layout", "title"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "https://visual-report.dev/schemas/report.schema.json#/definitions/sectionId" },
          "layout": {
            "enum": ["title", "section", "bullets", "kpi", "chart", "diagram", "quote", "two-col", "table", "statement"]
          },
          "title": { "type": "string", "minLength": 1 },
          "subtitle": { "type": "string" },
          "kicker": { "type": "string" },
          "notes": { "type": "string", "description": "演讲者备注（按页 ID 存储，重排不串页）" },
          "blocks": {
            "type": "array",
            "items": { "$ref": "https://visual-report.dev/schemas/report.schema.json#/definitions/block" }
          }
        }
      }
    }
  }
}
